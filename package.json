{
  "name": "fluxtransfer",
  "version": "3.0.0",
  "private": true,
  "description": "Internet-first peer-to-peer file transfer using WebRTC and PeerJS",
  "scripts": {
    "dev": "node src/server/signaling-server.js",
    "start": "node src/server/signaling-server.js",
    "dev:static": "npx serve --no-request-logging src/client",
    "build:apk": "node scripts/build-apk.js"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "file-transfer",
    "peerjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
